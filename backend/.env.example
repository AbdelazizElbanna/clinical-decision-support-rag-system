# MedLens AI - Environment Variables

# --- Security ---
# Secret key for JWT token generation. Must be a long, random string in production.
# You can generate one using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here

# --- LLM Provider (Groq) ---
# You can provide a single key:
GROQ_API_KEY=gsk_your_key_here
# Or provide multiple keys separated by commas for rate-limit rotation:
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Optional: Override the default LLM model
LLM_MODEL=openai/gpt-oss-120b

# --- Other APIs ---
# GEMINI_API_KEY=your_gemini_key_here
